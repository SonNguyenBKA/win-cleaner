<Window x:Class="WinCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win Cleaner" Width="1000" Height="650" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SectionList" Grid.Column="0" Background="#F3F3F3" BorderThickness="0"
                 Padding="8,12" SelectionChanged="SectionList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Width="28" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="32,24">
            <TextBlock x:Name="SectionTitle" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Chưa làm." Margin="0,12,0,0" Foreground="Gray" />
        </StackPanel>
    </Grid>
</Window>
